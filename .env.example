# =============================================
# SimpleBank OTel — Environment Variables
# Copy this file to .env and fill in values
# =============================================

# --- Elasticsearch ---
ELASTIC_URL=https://your-cluster.es.io:9243
ELASTIC_API_KEY=your_elastic_api_key_here

# --- OpenTelemetry / Elastic APM ---
OTLP_ENDPOINT=https://your-apm.apm.io:443
OTLP_TOKEN=your_secret_token_here

# --- Backend ---
BACKEND_DOMAIN=https://your-domain.com
BACKEND_PORT=8000

# --- Nginx (GCP only) ---
DOMAIN=your-domain.com
